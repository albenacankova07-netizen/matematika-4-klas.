</style></head><body><main>
<h1>Математика за 4. клас</h1>
<div class="id"><label>Име: <input aria-label="Име"></label><label>Клас: <input aria-label="Клас"></label></div>
<select id="sel" class="noprint" aria-label="Избери тема"></select>
<section class="ex" id="ex"></section>
<div id="box"></div>
<div class="bar"><button id="bc" class="p">Провери</button><button id="bs">Решение</button><button id="bn">Нови задачи</button><button id="bp">Принтирай</button><span id="sc"></span></div>
<script>
const $=i=>document.getElementById(i),R=(a,b)=>Math.floor(Math.random()*(b-a+1))+a,pw=n=>10**n,rl=n=>R(pw(n-1),pw(n)-1);
const C=(c,k='')=>`<i class="c ${k}">${c}</i>`,E=()=>C('','e'),pad=k=>E().repeat(Math.max(0,k)),digs=s=>[...String(s)].map(d=>C(d,'d')).join('');
const A=(s,d,f,k='')=>[...String(s)].map(x=>f?C(x,'x '+k):`<input class="c a ${k}" maxlength="1" inputmode="numeric" autocomplete="off" data-a="${x}" data-d="${d}">`).join('');
const row=(h,k='')=>`<div class="r ${k}">${h}</div>`,box=(W,h)=>`<div class="v" style="--s:${Math.min(1.8,18.5/W).toFixed(2)}rem">${h}</div>`;
const num=d=>+d.join(''),dg=(n,f)=>Array.from({length:n},(_,i)=>f(i));
const cnt=(a,b,s)=>{let c=0,k=0;while(a>0||b>0){const x=a%10,y=b%10;if(s?x-y-k<0:x+y+k>9){k=1;c++}else k=0;a=Math.floor(a/10);b=Math.floor(b/10)}return c};
const mc=(a,m)=>{let c=0,k=0;while(a>0){k=Math.floor(((a%10)*m+k)/10);if(k)c++;a=Math.floor(a/10)}return c};
const V=(a,o,b,r)=>({k:'v',a,o,b,r,d:'r'}),H=(t,r,d='r',w=3)=>({k:'h',t,r,d,w}),Dv=(d,q)=>({k:'d',n:d*q,d,q});
function vert(t,f){const sa=''+t.a,sb=''+t.b,sr=''+t.r,n=Math.max(sa.length,sb.length,sr.length)+1;
return box(n,row(pad(n-sa.length)+digs(sa))+row(C(t.o,'s')+pad(n-1-sb.length)+digs(sb),'ln')+row(pad(n-sr.length)+A(sr,'r',f))+(t.c&&!f?'<div class="cap">Проверка със събиране:</div>'+row(pad(n))+row(pad(n)):''))}
function hor(t,f){const q=t.t.includes('▢'),L=(''+t.r).length;
const W=t.t.reduce((s,x)=>s+(typeof x==='number'?(''+x).length:x==='▢'?L:1),0)+(q?0:1+L);
let h=t.t.map(x=>typeof x==='number'?digs(x):x==='▢'?A(t.r,t.d,f):C(x,'s')).join('')+(q?'':C('=','s')+A(t.r,t.d,f));
return box(W,row(h)+Array.from({length:f?0:t.w},()=>row(pad(W))).join(''))}
function div(t,f){const sn=''+t.n,n=sn.length,sd=''+t.d,L=(''+t.q).length,W=n+3+sd.length+L;
let k=1;while(+sn.slice(0,k)<t.d&&k<n)k++;
let idx=k,cur=+sn.slice(0,k),h=row(C('−','s')+digs(sn)+C(':','s')+digs(sd)+C('=','s')+A(t.q,'l',f));
for(;;){const qd=Math.floor(cur/t.d),pr=''+qd*t.d,rem=cur-qd*t.d;
h+=row(pad(idx-pr.length+1)+A(pr,'r',f,'ul')+pad(W-1-idx));
if(idx>=n){h+=row(pad(idx)+A(''+rem,'r',f)+pad(W-1-idx));break}
cur=rem*10+(+sn[idx]);idx++;while(cur<t.d&&idx<n){cur=cur*10+(+sn[idx]);idx++}
const ns=''+cur;h+=row(pad(idx-ns.length)+C('−','s')+A(ns,'r',f)+pad(W-1-idx))}
return box(W,h+(t.c&&!f?'<div class="cap">Проверка с умножение:</div>'+row(pad(W))+row(pad(W)):''))}
function mul(t,f){const a=''+t.a,b=''+t.b,r=''+t.r,p1=''+t.a*(+b%10),p2=''+t.a*Math.floor(+b/10),W=Math.max(a.length+1+b.length,r.length,p1.length,p2.length+2)+1;
return box(W,row(digs(a)+C('·','s')+digs(b)+pad(W-a.length-1-b.length),'ln')+row(pad(W-p1.length)+A(p1,'r',f))+row(C('+','s')+pad(W-p2.length-2)+A(p2,'r',f)+E(),'ln')+row(pad(W-r.length)+A(r,'r',f)))}
const rend=(t,f)=>({v:vert,h:hor,d:div,m:mul})[t.k](t,f);
const Dc=(d,q)=>({...Dv(d,q),c:1});
const Sc=(a,b)=>({...V(a,'−',b,a-b),c:1});
const exV=(a,o,b,r)=>vert(V(a,o,b,r),1),exD=(d,q)=>div(Dv(d,q),1),exH=(t,r)=>hor({t,r,d:'r',w:0},1);
const g={
a0:()=>{const n=R(4,6),A_=[],B=[];for(let i=0;i<n;i++){const a=R(i?0:1,8);A_.push(a);B.push(R(i?0:1,9-a))}const a=num(A_),b=num(B);return V(a,'+',b,a+b)},
a1:()=>{let a,b;do{a=rl(R(4,6));b=rl(R(3,5))}while(cnt(a,b)<2);return V(a,'+',b,a+b)},
s0:()=>{const n=R(4,6),A_=[],B=[];for(let i=0;i<n;i++){const a=i?R(0,9):R(2,9);A_.push(a);B.push(i?R(0,a):R(1,a))}const a=num(A_),b=num(B);return Sc(a,b)},
s1:()=>{let a,b;do{a=rl(R(4,6));b=rl(R(3,5))}while(b>=a||cnt(a,b,1)<2);return Sc(a,b)},
m0:()=>{const a=R(2,9)*pw(R(1,6)),m=R(2,9);return H([a,'·',m],a*m)},
m1:()=>{const m=R(2,4),a=num(dg(R(3,6),i=>R(i?0:1,Math.floor(9/m))));return H([a,'·',m],a*m)},
m2:()=>{let a,m;do{a=rl(R(3,5));m=R(2,9)}while(mc(a,m)<2);return H([a,'·',m],a*m)},
m3:()=>{const a=R(100,99999),t=R(2,9)*10;return H([a,'·',t],a*t)},
m4:()=>{let b;do{b=R(11,99)}while(b%10==0);const a=rl(R(3,5));return{k:'m',a,b,r:a*b}},
m5:()=>{const c=R(2,9),x=R(2,9)*1000,y=R(1,9)*pw(R(1,2));return H(R(0,1)?['(',x,'−',y,')','·',c]:[x,'·',c,'−',y,'·',c],(x-y)*c)},
d0:()=>{const d=R(2,9);return Dv(d,R(1,9)*pw(R(1,5)))},
d1:()=>Dc(R(2,9),R(100,99999)),
d2:()=>{const n=R(3,4),A_=dg(n,i=>i?R(0,9):R(1,9));A_[R(1,n-1)]=0;return Dc(R(2,R(0,1)?99:9),num(A_))},
d3:()=>Dc(R(2,9)*10,R(10,999)),
d4:()=>Dc(R(11,99),R(11,pw(R(2,4))-1)),
un:k=>[()=>{const a=rl(R(4,5)),x=rl(R(4,5));return H(['▢','+',a,'=',a+x],x,'r',2)},
()=>{const x=rl(R(3,5)),b=rl(R(3,5));return H([x+b,'−','▢','=',b],x,'r',2)},
()=>{const a=rl(R(3,5)),b=rl(R(3,5));return H(['▢','−',a,'=',b],a+b,'r',2)},
()=>{const c=R(2,9),x=R(100,9999);return H(['▢','·',c,'=',x*c],x,'r',2)},
()=>{const c=R(2,9),q=R(100,999);return H(['▢',':',c,'=',q],q*c,'r',2)},
()=>{const c=R(2,9),x=R(100,9999);return H([c*x,':','▢','=',c],x,'l',2)},
()=>{const c=rl(4),b=rl(5),x=rl(R(3,4));return H([b-c+x,'−','▢','=',b,'−',c],x,'r',2)},
()=>{const q=R(2,99),x=R(100,999),e=rl(4);return H([x*q,':','▢','=',e,'−',e-q],x,'l',2)}][k](),
ex:()=>{const t=R(0,3),d=R(2,9),q=R(100,999);
if(t==0){const s=d*q,x=R(1,s-1);return H(['(',x,'+',s-x,')',':',d],q,'l',2)}
if(t==1){const b=R(2,9),c=R(100,999);return H([d*q,':',d,'+',b,'·',c],q+b*c,'r',2)}
if(t==2){const A_=R(5000,9999),b=R(2,9),c=R(100,500);return H([A_,'−',b,'·',c],A_-b*c,'r',2)}
const B=R(100,999),A_=B+R(100,9000);return H(['(',A_,'−',B,')','·',d],(A_-B)*d,'r',2)}
};
const RL='<p class="hint"><b>Отговорът се пише отдясно наляво</b> – започваш от квадратчето за единиците.</p>',LR='<p class="hint"><b>Частното се пише отляво надясно</b> – започваш от първото квадратче, а междинните резултати – отдясно наляво.</p>';
let T=[
['Събиране и изваждане','Събиране без преминаване',`<p>Събираме цифрите, които са една под друга: единици с единици, десетици с десетици…</p>${exV(43285,'+',32612,75897)}<p>5+2=7, 8+1=9, 2+6=8, 3+2=5, 4+3=7.</p>${RL}`,g.a0],
['Събиране и изваждане','Събиране с преминаване',`<p>Когато сборът е 10 или повече, пишем единиците, а десетицата прибавяме към следващия разред.</p>${exV(62485,'+',4703,67188)}<p>5+3=8; 8+0=8; 4+7=11 – пишем 1 и помним 1; 2+4+1=7; 6 остава.</p>${RL}`,g.a1],
['Събиране и изваждане','Изваждане без преминаване',`<p>От всяка цифра на умаляемото изваждаме цифрата под нея.</p>${exV(75897,'−',32612,43285)}<p>Проверка със събиране: 43 285 + 32 612 = 75 897.</p>${RL}`,g.s0],
['Събиране и изваждане','Изваждане с преминаване',`<p>Когато горната цифра е по-малка, взимаме 1 от следващия разред.</p>${exV(9377,'−',4128,5249)}<p>7−8 не може: 17−8=9 (десетиците стават 6); 6−2=4; 3−1=2; 9−4=5. Проверка: 5 249 + 4 128 = 9 377.</p>${RL}`,g.s1],
['Умножение','Умножение на кръгли числа',`<p>Умножаваме цифрите, различни от нула, и дописваме нулите.</p>${exH([2000,'·',3],6000)}${exH([20000,'·',6],120000)}<p>2·3=6 и три нули → 6000. 2·6=12 и четири нули → 120 000.</p>${RL}`,g.m0],
['Умножение','Многоцифрено · едноцифрено, без преминаване',`<p>Умножаваме всяка цифра по едноцифреното число.</p>${exH([2134,'·',2],4268)}<p>4·2=8, 3·2=6, 1·2=2, 2·2=4.</p>${RL}`,g.m1],
['Умножение','Многоцифрено · едноцифрено, с преминаване',`<p>Пишем единиците на произведението, а десетиците прибавяме към следващото произведение.</p>${exH([1475,'·',6],8850)}<p>5·6=30 – пишем 0, помним 3; 7·6=42+3=45 – пишем 5, помним 4; 4·6=24+4=28 – пишем 8, помним 2; 1·6=6+2=8.</p>${RL}`,g.m2],
['Умножение','Умножение с 20, 30, …, 90',`<p>Умножаваме с 2, 3, …, 9, а после с 10 (дописваме нула).</p>${exH([212,'·',40],8480)}<p>212 · 40 = (212 · 4) · 10 = 848 · 10 = 8480. В мрежата под задачата пресмятай.</p>${RL}`,g.m3],
['Умножение','Умножение с двуцифрено число',`<p>Умножаваме по единиците, после по десетиците – второто произведение пишем с една позиция наляво – и събираме. Пресмятай в мрежата под задачата.</p>${exH([134,'·',13],1742)}<p>134·3=402; 134·10=1340; 402+1340=1742.</p>${RL}`,g.m4],
['Умножение','Умножение на разлика с число',`<p>Разлика се умножава с число, като умаляемото и умалителят се умножат с числото и произведенията се извадят.</p><p>(500 − 50) · 3 = 450 · 3 = 1350<br>500 · 3 − 50 · 3 = 1500 − 150 = <b>1350</b></p>${RL}`,g.m5],
['Деление','Деление на кръгли числа',`<p>Делим цифрите, различни от нула, и дописваме нулите, които остават.</p>${exD(3,2000)}<p>6000 : 3: 6:3=2 и три нули → 2000.</p>${LR}`,g.d0],
['Деление','Деление с едноцифрено (с опашка)',`<p>Делим цифра по цифра: пишем частното, умножаваме, изваждаме и сваляме следващата цифра.</p>${exD(3,130231)}<p>390 693 : 3: 3:3 = 1; сваляме 9 → 9:3 = 3; сваляме 0 → 0:3 = 0; сваляме 6 → 6:3 = 2; сваляме 9 → 9:3 = 3; сваляме 3 → 3:3 = 1. Частно 130 231. Проверка: 130 231 · 3 = 390 693.</p>${LR}`,g.d1],
['Деление','Деление с нула в частното',`<p>Когато след свалянето на цифра числото е по-малко от делителя, пишем 0 в частното и сваляме следващата цифра.</p>${exD(35,102)}<p>3570 : 35 = 102: 35:35=1 → сваляме 7: 7<35, пишем 0 → сваляме 0: 70:35=2. Проверка: 102 · 35 = 3570.</p>${LR}`,g.d2],
['Деление','Деление с 20, 30, …, 90',`<p>Делимото и делителят се представят като десетици и се делят като едноцифрени.</p><p>210 : 30 = 21 дес. : 3 дес. = <b>7</b><br>35 650 : 50 = 3565 дес. : 5 дес. = <b>713</b></p>${exD(50,713)}${LR}`,g.d3],
['Деление','Деление с двуцифрено число',`<p>Търсим най-близкото по-малко число, което се дели на делителя.</p>${exD(41,67)}<p>2747 : 41 = 67: 27 < 41, вземаме 274. Най-близкото до 274 е 246 = 6·41 → пишем 6. 274−246=28, сваляме 7 → 287 = 7·41 → пишем 7. Проверка: 67 · 41 = 2747.</p>${LR}`,g.d4],
['Неизвестно число и изрази','Неизвестно число',`<p>Намираме неизвестното с обратното действие.</p><p>▢ + 44 612 = 59 465 → ▢ = 59 465 − 44 612 = 14 853<br>▢ · 5 = 100 000 → ▢ = 100 000 : 5 = 20 000<br>80 000 : ▢ = 8 → ▢ = 80 000 : 8 = 10 000</p><p>Пишем неизвестното в квадратчетата.</p>`,g.un],
['Неизвестно число и изрази','Числови изрази с няколко действия',`<p>Първо действията в скобите. После умножение и деление, а накрая събиране и изваждане.</p><p>1200 − 800 : 4 = 1200 − 200 = <b>1000</b><br>(1200 − 800) : 4 = 400 : 4 = <b>100</b></p>`,g.ex],
['Неизвестно число и изрази','Контролно – смесени задачи','<p>Задачи от всички теми. Реши ги в мрежата и запиши отговора в квадратчетата.</p>',null]
].map(([gr,n,e,f])=>({gr,n,e,f}));
const pvt=(a,o,b)=>{const r=o==='+'?a+b:a-b,f=x=>[...String(x).padStart(6,' ')].map(d=>`<td>${d.trim()}</td>`).join('');return `<table class="pv"><tr>${['Ст.хил.','Дес.хил.','Хил.','Стот.','Дес.','Ед.'].map(h=>`<th>${h}</th>`).join('')}</tr><tr>${f(a)}</tr><tr>${f(b)}</tr><tr>${f(r)}</tr></table>`};
const pv=(i,a,o,b)=>{T[i].e=T[i].e.replace('<p class="hint">',`<p>По разреди:</p>${pvt(a,o,b)}<p class="hint">`)};
